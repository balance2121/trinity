<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>🎬 스마트 영화 티어리스트</title>
<style>
  :root { --net-red: #e50914; --net-black: #141414; --net-grey: #1f1f1f; }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body { background: var(--net-black); color: #fff; font-family: 'Pretendard', sans-serif; padding: 20px; }
  
  h1 { color: var(--net-red); text-align: center; margin-bottom: 30px; font-size: 2.5rem; }

  /* 입력 구역 */
  .input-container {
    background: var(--net-grey);
    padding: 20px;
    border-radius: 10px;
    max-width: 800px;
    margin: 0 auto 40px;
    display: flex;
    gap: 10px;
    align-items: center;
    box-shadow: 0 4px 15px rgba(0,0,0,0.5);
  }
  input, select {
    padding: 12px;
    border-radius: 5px;
    border: 1px solid #333;
    background: #2b2b2b;
    color: #fff;
    font-size: 1rem;
  }
  input { flex: 2; }
  select { flex: 1; }
  .add-btn {
    flex: 1;
    background: var(--net-red);
    color: white;
    border: none;
    padding: 12px;
    border-radius: 5px;
    font-weight: bold;
    cursor: pointer;
    transition: 0.3s;
  }
  .add-btn:hover { background: #ff1e2a; transform: scale(1.05); }

  /* 티어 구역 */
  .tier-row {
    display: flex;
    margin-bottom: 20px;
    background: #1a1a1a;
    border-radius: 8px;
    overflow: hidden;
    min-height: 180px;
  }
  .tier-label {
    width: 80px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2rem;
    font-weight: bold;
    color: #141414;
  }
  .label-S { background: #ff7f7f; }
  .label-A { background: #ffbf7f; }
  .label-B { background: #ffff7f; }
  .label-C { background: #7fff7f; }

  .movie-list {
    display: flex;
    flex-wrap: wrap;
    gap: 15px;
    padding: 15px;
    flex: 1;
  }

  /* 영화 카드 */
  .movie-card {
    width: 130px;
    background: #262626;
    border-radius: 5px;
    overflow: hidden;
    position: relative;
    transition: 0.3s;
    font-size: 0.8rem;
  }
  .movie-card:hover { transform: translateY(-5px); box-shadow: 0 5px 15px rgba(229, 9, 20, 0.3); }
  .movie-card img { width: 100%; height: 180px; object-fit: cover; }
  .card-info { padding: 8px; }
  .card-title { font-weight: bold; margin-bottom: 4px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .card-meta { color: #aaa; font-size: 0.7rem; }
  .card-star { color: #ffd700; margin-top: 4px; }
  
  .del-btn {
    position: absolute; top: 5px; right: 5px;
    background: rgba(0,0,0,0.7); color: white; border: none;
    width: 20px; height: 20px; border-radius: 50%; cursor: pointer;
  }
</style>
</head>
<body>

<h1>NETFLIX TIER LIST</h1>

<div class="input-container">
  <input type="text" id="movieTitle" placeholder="영화 제목을 입력하세요 (예: 기생충, 타이타닉)">
  <select id="movieGrade">
    <option value="S">S 등급</option>
    <option value="A">A 등급</option>
    <option value="B">B 등급</option>
    <option value="C">C 등급</option>
  </select>
  <button class="add-btn" onclick="handleNewMovie()">리스트에 추가</button>
</div>

<div id="tiers">
  <div class="tier-row"><div class="tier-label label-S">S</div><div class="movie-list" id="list-S"></div></div>
  <div class="tier-row"><div class="tier-label label-A">A</div><div class="movie-list" id="list-A"></div></div>
  <div class="tier-row"><div class="tier-label label-B">B</div><div class="movie-list" id="list-B"></div></div>
  <div class="tier-row"><div class="tier-label label-C">C</div><div class="movie-list" id="list-C"></div></div>
</div>

<script>
  // 1. 영화 데이터베이스 (제목만 치면 불러올 데이터들)
  const movieDB = {
    "기생충": { director: "봉준호", year: "2019", genre: "드라마", star: 5, review: "선과 악의 경계가 무너지는 걸작", poster: "https://upload.wikimedia.org/wikipedia/ko/6/60/%EA%B8%B0%EC%83%9D%EC%B6%A9_%ED%8F%AC%EC%8A%A4%ED%84%B0.jpg" },
    "인셉션": { director: "크리스토퍼 놀란", year: "2010", genre: "SF", star: 5, review: "꿈속의 꿈, 완벽한 설계", poster: "https://upload.wikimedia.org/wikipedia/ko/5/5e/%EC%9D%B8%EC%85%89%EC%85%98_%ED%8F%AC%EC%8A%A4%ED%84%B0.jpg" },
    "인터스텔라": { director: "크리스토퍼 놀란", year: "2014", genre: "SF", star: 5, review: "우리는 답을 찾을 것이다", poster: "https://upload.wikimedia.org/wikipedia/ko/0/05/%EC%9D%B8%ED%84%B0%EC%8A%A4%ED%85%94%EB%9D%BC_%ED%8F%AC%EC%8A%A4%ED%84%B0.jpg" },
    "다크 나이트": { director: "크리스토퍼 놀란", year: "2008", genre: "액션", star: 5, review: "최고의 히어로 영화", poster: "https://upload.wikimedia.org/wikipedia/ko/8/83/%EB%8B%A4%ED%81%AC_%EB%82%98%EC%9D%B4%ED%8A%B8_%ED%8F%AC%EC%8A%A4%ED%84%B0.jpg" },
    "어바웃 타임": { director: "리차드 커티스", year: "2013", genre: "로맨스", star: 4, review: "오늘을 소중하게 살게 해주는 영화", poster: "https://upload.wikimedia.org/wikipedia/ko/e/e1/%EC%96%B4%EB%B0%94%EC%9B%83_%ED%83%80%EC%9E%84_%ED%8F%AC%EC%8A%A4%ED%84%B0.jpg" },
    "센과 치히로의 행방불명": { director: "미야자키 하야오", year: "2001", genre: "애니메이션", star: 5, review: "잊을 수 없는 판타지", poster: "https://upload.wikimedia.org/wikipedia/ko/a/af/%EC%84%BC%EA%B3%BC_%EC%B9%98%ED%9E%88%EB%A1%9C%EC%9D%98_%ED%96%89%EB%B0%A9%EB%B6%88%EB%AA%85_%ED%8F%AC%EC%8A%A4%ED%84%B0.jpg" },
    "라라랜드": { director: "데미언 셔젤", year: "2016", genre: "뮤지컬", star: 5, review: "꿈꾸는 사람들을 위한 찬가", poster: "https://upload.wikimedia.org/wikipedia/ko/a/a2/%EB%9D%BC%EB%9D%BC%EB%9E%9C%EB%93%9C_%ED%8F%AC%EC%8A%A4%ED%84%B0.jpg" },
    "어벤져스: 엔드게임": { director: "루소 형제", year: "2019", genre: "액션", star: 4, review: "3000만큼 사랑해", poster: "https://upload.wikimedia.org/wikipedia/ko/0/0d/%EC%96%B4%EB%B2%A4%EC%A0%B8%EC%8A%A4-_%EC%97%94%EB%93%9C%EA%B2%8C%EC%9E%84_%ED%8F%AC%EC%8A%A4%ED%84%B0.jpg" },
    "조커": { director: "토드 필립스", year: "2019", genre: "스릴러", star: 5, review: "내 인생이 비극인 줄 알았는데...", poster: "https://upload.wikimedia.org/wikipedia/ko/4/44/%EC%A1%B0%EC%BB%A4_%ED%8F%AC%EC%8A%A4%ED%84%B0.jpg" },
    "타이타닉": { director: "제임스 카메론", year: "1997", genre: "로맨스", star: 5, review: "영원히 기억될 사랑 이야기", poster: "https://upload.wikimedia.org/wikipedia/ko/2/22/%ED%83%80%EC%9D%B4%ED%83%80%EB%8B%89_%ED%8F%AC%EC%8A%A4%ED%84%B0.jpg" }
  };

  // 2. 초기 데이터 (10개 기본 배치)
  let myMovies = JSON.parse(localStorage.getItem('myMovies')) || [
    { title: "기생충", grade: "S" }, { title: "인셉션", grade: "S" },
    { title: "인터스텔라", grade: "A" }, { title: "다크 나이트", grade: "S" },
    { title: "어바웃 타임", grade: "B" }, { title: "센과 치히로의 행방불명", grade: "A" },
    { title: "라라랜드", grade: "A" }, { title: "어벤져스: 엔드게임", grade: "B" },
    { title: "조커", grade: "A" }, { title: "타이타닉", grade: "S" }
  ];

  // 3. 영화 추가 로직
  function handleNewMovie() {
    const title = document.getElementById('movieTitle').value.trim();
    const grade = document.getElementById('movieGrade').value;

    if (!title) return alert("제목을 입력하세요!");

    // DB에 정보가 있는지 확인, 없으면 기본값 적용
    const info = movieDB[title] || { 
      director: "정보 없음", year: "미상", genre: "기타", star: 3, review: "내가 추가한 영화!", 
      poster: "https://via.placeholder.com/130x180?text=No+Image" 
    };

    myMovies.push({ title, grade });
    saveAndRender();
    document.getElementById('movieTitle').value = "";
  }

  // 4. 삭제 로직
  function deleteMovie(index) {
    myMovies.splice(index, 1);
    saveAndRender();
  }

  // 5. 저장 및 화면 그리기
  function saveAndRender() {
    localStorage.setItem('myMovies', JSON.stringify(myMovies));
    
    // 화면 초기화
    ['S','A','B','C'].forEach(g => document.getElementById(`list-${g}`).innerHTML = '');

    myMovies.forEach((m, index) => {
      const info = movieDB[m.title] || { 
        director: "정보 없음", year: "-", genre: "-", star: 0, review: "", 
        poster: "https://via.placeholder.com/130x180?text=No+Image" 
      };

      const card = `
        <div class="movie-card">
          <button class="del-btn" onclick="deleteMovie(${index})">×</button>
          <img src="${info.poster}" alt="poster">
          <div class="card-info">
            <div class="card-title">${m.title}</div>
            <div class="card-meta">${info.year} · ${info.director}</div>
            <div class="card-star">${'⭐'.repeat(info.star)}</div>
          </div>
        </div>
      `;
      document.getElementById(`list-${m.grade}`).innerHTML += card;
    });
  }

  // 첫 실행
  saveAndRender();
</script>

</body>
</html>
